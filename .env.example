# Copie este arquivo para .env e preencha com sua chave.
# Gere uma chave gratuita em https://aistudio.google.com/apikey (não precisa de cartão)
GEMINI_API_KEY=your_key_here

# Supabase (obrigatório para persistir os formulários)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
ADMIN_PASSWORD=defina_uma_senha_forte

# Porta local do servidor (opcional)
PORT=3000
